{
  "host": "0.0.0.0",
  "port": 8093,
  "api_key": null,
  "poll_interval": 600,
  "_comment_weatherkit": "Only needed when a sensor uses the 'applewx' rain source. Apple Developer key; keep these LOCAL (gitignored), never commit real values. The .p8 path points outside the repo.",
  "weatherkit_key_path": "/path/to/AuthKey.p8",
  "weatherkit_key_id": "YOUR_KEY_ID",
  "weatherkit_team_id": "YOUR_TEAM_ID",
  "weatherkit_service_id": "com.example.weather",
  "sensors": [
    {
      "id": "dev_weather_hanoi",
      "name": "Hanoi Weather",
      "latitude": 21.0285,
      "longitude": 105.8542,
      "fields": ["temperature", "humidity", "pressure"],
      "provider": "open-meteo",
      "model": "ecmwf_ifs025",
      "metar_station": "VVNB",
      "metar_fields": ["temperature", "pressure"]
    },
    {
      "id": "dev_rain_hanoi",
      "name": "Hanoi Rain",
      "latitude": 21.0285,
      "longitude": 105.8542,
      "fields": ["rain"],
      "model": "ecmwf_ifs025",
      "metar_station": "VVNB",
      "rain_sources": ["applewx", "rainviewer", "metar", "model"],
      "rain_threshold_mm": 0.1,
      "applewx_threshold_mm_h": 0.1,
      "rain_state": "rain"
    },
    {
      "id": "dev_brightness_hanoi",
      "name": "Hanoi Brightness",
      "latitude": 21.0285,
      "longitude": 105.8542,
      "fields": ["illuminance"],
      "model": "ecmwf_ifs025",
      "lux_per_wm2": 120
    }
  ]
}
